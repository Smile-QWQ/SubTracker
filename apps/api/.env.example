PORT=3001
HOST=0.0.0.0
DATABASE_URL="file:./dev.db"
WEB_ORIGIN="http://localhost:5173"
LOG_LEVEL=warn
BASE_CURRENCY=CNY
DEFAULT_APP_LOCALE=zh-CN
TZ=Asia/Shanghai
CRON_SCAN=* * * * *
CRON_REFRESH_RATES=0 2 * * *
# Native ZIP backup limits in MiB. Empty temp quota defaults to twice the archive cap.
BACKUP_MAX_ARCHIVE_MIB=2048
BACKUP_MAX_EXPANDED_MIB=2048
BACKUP_TEMP_MAX_MIB=
# Optional; defaults to apps/api/storage/backup-temp, independent of the launch cwd.
BACKUP_TEMP_DIR=
# Optional; defaults to apps/api/storage/logos, independent of the launch cwd.
LOGO_STORAGE_DIR=
